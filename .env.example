# === Discord ===
# Токен бота из https://discord.com/developers/applications -> твоё приложение -> Bot -> Reset Token
DISCORD_TOKEN=

# Client ID приложения (Developer Portal -> General Information -> Application ID)
DISCORD_CLIENT_ID=

# === Anthropic (Claude) ===
# Ключ для ИИ-ответов. Получить на https://console.anthropic.com/
ANTHROPIC_API_KEY=

# === Веб-панель ===
# Пароль для входа в браузерную панель управления (придумай сам, любой)
PANEL_PASSWORD=changeme

# Порт, на котором поднимется веб-панель
PORT=3000
