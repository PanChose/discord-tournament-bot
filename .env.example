# === Discord application (https://discord.com/developers/applications) ===
# Bot -> Reset Token
DISCORD_TOKEN=
# General Information -> Application ID
DISCORD_CLIENT_ID=
# OAuth2 -> Client Secret (needed for the web panel's "Login with Discord")
DISCORD_CLIENT_SECRET=
# OAuth2 -> Redirects: must exactly match one entry there,
# e.g. http://localhost:3000/auth/discord/callback for local dev
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Restrict which server owner can add the bot (optional but recommended for a demo bot).
# User Settings -> Advanced -> Developer Mode, then right-click your name -> Copy User ID.
OWNER_DISCORD_ID=

# === Security ===
# Random string used to encrypt stored OAuth2 tokens at rest (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# === Anthropic (Claude) — optional AI tournament-description helper ===
ANTHROPIC_API_KEY=

# === Web panel ===
PORT=3000
NODE_ENV=development
