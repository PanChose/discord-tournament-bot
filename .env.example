# === Discord ===
# Bot token from https://discord.com/developers/applications -> your application -> Bot -> Reset Token
DISCORD_TOKEN=

# Application Client ID (Developer Portal -> General Information -> Application ID)
DISCORD_CLIENT_ID=

# === Anthropic (Claude) ===
# Key for AI responses. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# === Web panel ===
# Password for logging into the browser control panel (pick anything you like)
PANEL_PASSWORD=changeme

# Port the web panel will run on
PORT=3000
